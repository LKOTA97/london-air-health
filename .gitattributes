# Normalise text files to LF in the repository so Windows and Linux checkouts match
* text=auto eol=lf

# Keep raw downloads byte-for-byte as received
data/raw/** -text

# The rendered site: store exactly as Quarto writes it, so a fresh render
# does not show vendored libraries as changed
docs/** -text

# Binary files
*.xlsx binary
*.xls binary
*.duckdb binary
*.png binary
*.pdf binary
